# All optional. The host sets PORT itself.
# On a paid plan, mount a disk at /data so cached datasets survive restarts.
DATA_DIR=/data
# Comma separated origins allowed to call the API, e.g. https://your-app.vercel.app. Default: any.
ALLOWED_ORIGINS=*
MAX_DATASET_GB=10
CACHE_MAX_GB=20
INDEX_MAX_ROWS=2000000
# Gated data lives only until the token expires (OAuth) or this many hours (pasted tokens), and is deleted on sign out.
PRIVATE_TTL_HOURS=12
PUBLIC_IDLE_HOURS=24
DUCKDB_MEMORY=1GB
DUCKDB_THREADS=2
MAX_JOBS=2
